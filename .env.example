# Neon Postgres (added automatically by the Vercel Neon integration)
DATABASE_URL=
# Vercel Blob (created from the Vercel project's Storage tab)
BLOB_READ_WRITE_TOKEN=
# Random string; Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>` to /api/cron/publish
CRON_SECRET=

# Admin auth (Auth.js + Google)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only Google accounts on this email domain can sign in to /admin, e.g. themochi.app
ADMIN_EMAIL_DOMAIN=
